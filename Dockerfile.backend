FROM node:20-alpine

ARG BUILD_VERSION=development
ENV BUILD_VERSION=$BUILD_VERSION

RUN apk add --no-cache curl

WORKDIR /app
COPY backend/package*.json ./
COPY backend/tsconfig.json ./
# Skip lifecycle scripts during install: esbuild's postinstall executes an
# architecture-specific binary and can crash under Buildx/QEMU on arm64.
# Prisma is generated explicitly below after all sources are present.
RUN npm ci --ignore-scripts && npm cache clean --force

COPY backend/src/ ./src/
RUN npx prisma generate --schema=src/infrastructure/prisma/schema.prisma
RUN npm run build
RUN npm prune --omit=dev --ignore-scripts && npm cache clean --force

RUN addgroup -S atacte && adduser -S -G atacte atacte \
    && chown -R atacte:atacte /app

RUN echo '#!/bin/sh' > /usr/local/bin/health-check.sh && \
    echo 'curl -f http://localhost:3001/health || exit 1' >> /usr/local/bin/health-check.sh && \
    chmod +x /usr/local/bin/health-check.sh

USER atacte

EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 CMD /usr/local/bin/health-check.sh
CMD ["node", "dist/server.js"]
