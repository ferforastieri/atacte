PORT=3001
NODE_ENV=production

DATABASE_URL=postgresql://usuario:senha@localhost:5432/atacte?sslmode=disable

JWT_SECRET=chave_jwt_pelo_menos_32_caracteres
JWT_EXPIRES_IN=7d

# Chave-mestra externa ao banco; use 32+ caracteres aleatórios e não a altere
# sem executar uma migração/backup planejado.
ENCRYPTION_KEY=chave-mestra-aleatoria-de-32-caracteres

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

CORS_ORIGIN=https://atacte.example.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
COOKIE_MAX_AGE_MS=2592000000
TRUST_PROXY=0
JWT_ISSUER=atacte-api
JWT_AUDIENCE=atacte-clients
UPDATER_URL=http://atacte-updater:8080
UPDATER_TOKEN=
LOG_LEVEL=info

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=Atacte
PASSWORD_RESET_URL=
